local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local avatarIcon = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"

local Window = WindUI:CreateWindow({
    Title = "Duck私人定制",
    Author = "duck",
    Folder = "TeleportBehind",
    Size = UDim2.fromOffset(500, 450),
    Transparent = true,
    Theme = "Dark",
    User = { Enabled = true, Anonymous = false, Icon = avatarIcon },
})

local Tab = Window:Tab({ Title = "功能", Icon = "crosshair" })

-- ==================== 瞬移部分 ====================
local targetPlayer = nil
local tpConnection = nil
local selectedName = nil

local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(names, p.Name) end
    end
    return names
end

Tab:Dropdown({
    Title = "选择瞬移目标",
    Values = getPlayerNames(),
    Callback = function(option)
        selectedName = option
        targetPlayer = Players:FindFirstChild(option)
    end,
})

local function stopTeleport()
    if tpConnection then tpConnection:Disconnect(); tpConnection = nil end
end

local function startTeleport()
    stopTeleport()
    tpConnection = RunService.Heartbeat:Connect(function()
        if not targetPlayer or not targetPlayer.Character then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP or not targetHRP then return end
        local behindPos = targetHRP.Position - (targetHRP.CFrame.LookVector * 5)
        myHRP.CFrame = CFrame.new(behindPos, targetHRP.Position)
    end)
end

Tab:Toggle({
    Title = "持续瞬移到身后",
    Default = false,
    Callback = function(state)
        if state then
            if not selectedName then
                WindUI:Notify({ Title = "错误", Content = "请先选择目标", Duration = 3 })
                return
            end
            targetPlayer = Players:FindFirstChild(selectedName)
            if not targetPlayer then
                WindUI:Notify({ Title = "错误", Content = "目标已离开", Duration = 3 })
                return
            end
            startTeleport()
        else
            stopTeleport()
        end
    end,
})

-- ==================== 自瞄部分 ====================
local aimEnabled = false
local aimConnection = nil

Tab:Toggle({
    Title = "自瞄（锁定附近玩家头部）",
    Default = false,
    Callback = function(state)
        aimEnabled = state
        if not state and aimConnection then
            aimConnection:Disconnect()
            aimConnection = nil
        end
    end,
})

-- 找鼠标附近最近的玩家头部
local function getClosestTarget()
    local closest = nil
    local shortest = math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

-- 主循环：自瞄平滑跟随
RunService.RenderStepped:Connect(function()
    if not aimEnabled then return end
    local targetHead = getClosestTarget()
    if not targetHead then return end

    local camPos = Camera.CFrame.Position
    local lookAt = CFrame.new(camPos, targetHead.Position)
    Camera.CFrame = Camera.CFrame:Lerp(lookAt, 0.15)
end)
